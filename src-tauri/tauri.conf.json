{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/tooling/cli/schema.json",
  "productName": "Clarity",
  "version": "0.1.1",
  "identifier": "com.clarity.studio",
  "build": {
    "frontendDist": "./shell"
  },
  "app": {
    "windows": [
      {
        "title": "Clarity \u2014 AI Video Studio",
        "width": 1380,
        "height": 880,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "visible": true,
        "dragDropEnabled": false,
        "devtools": true
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": [
      "resources/uv.exe",
      "resources/ffmpeg.exe",
      "resources/ffprobe.exe",
      "resources/pyproject.toml",
      "resources/README.md",
      "resources/main.py",
      "resources/src/**/*"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "hooks.nsh",
        "installMode": "currentUser",
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDEwRTYxNTNGMjhGQUY2REIKUldUYjl2b29QeFhtRUNDYXNOQ0ZndUhGeTc4YndxN2JJNHpOdUdsQ1Z1NUZmZnI3c2NmZUpzbWMK",
      "endpoints": [
        "https://github.com/Rik-rut/Clarity/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
